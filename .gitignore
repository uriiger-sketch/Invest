.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
.env
# data/invest.db is intentionally COMMITTED: it is the pipeline's state
# between scheduled runs. actions/cache proved unreliable (see crawl.yml).
data/*.db-journal
dist/
build/
*.egg-info/
.streamlit/
# NOTE: data/models/*.txt (trained LightGBM models) is intentionally
# COMMITTED, same rationale as data/invest.db above — a model that only ever
# lives on one ephemeral runner is a model that never survives to be used.
# (The old "models/*.lgb" rule below was already stale/dead: models are
# actually saved to data/models/*.txt, a path this rule never matched.)
