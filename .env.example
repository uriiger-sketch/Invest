# Copy to .env and fill in.

# Finnhub free tier: https://finnhub.io/register (60 req/min).
FINNHUB_API_KEY=

# SEC requires a descriptive User-Agent with a contact email.
# See https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="Invest Research Client <you@example.com>"

# Turn ToS-gray scrapers (Finviz) on/off. Leave false unless you have a reason.
SCRAPE_OK=false

# SQLite path (inside container or host).
INVEST_DB_URL=sqlite:///data/invest.db

# Universe size cap (0 = no cap, use full S&P500 + NDX100 union).
UNIVERSE_MAX=0

# Streamlit / scheduler bind.
STREAMLIT_PORT=8501
RUN_SCHEDULER=true
